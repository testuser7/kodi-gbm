+bool CAESinkALSA::ChmapHasTrailingPhantom(snd_pcm_chmap_t* map)
+{
+  if (!map || map->channels == 0)
+    return false;
+  unsigned int last = map->pos[map->channels - 1];
+  return last == SND_CHMAP_UNKNOWN || last == SND_CHMAP_NA;
+}
+
+snd_pcm_chmap_t* CAESinkALSA::SelectFullLayoutChmap(const CAEChannelInfo& info)
+{
+  snd_pcm_chmap_query_t** supportedMaps = snd_pcm_query_chmaps(m_pcm);
+  if (!supportedMaps)
+    return NULL;
+
+  snd_pcm_chmap_t* best = NULL;
+  unsigned int bestChannels = 0;
+
+  int i = 0;
+  for (snd_pcm_chmap_query_t* supportedMap = supportedMaps[i++];
+       supportedMap; supportedMap = supportedMaps[i++])
+  {
+    snd_pcm_chmap_t* map = &supportedMap->map;
+    CLog::Log(LOGDEBUG, "CAESinkALSA::SelectFullLayoutChmap - supported {} (phantom: {})",
+              ALSAchmapToString(map), ChmapHasTrailingPhantom(map) ? "yes" : "no");
+
+    /* skip layouts with a trailing phantom channel (ELD padding) */
+    if (ChmapHasTrailingPhantom(map))
+      continue;
+
+    CAEChannelInfo candidate = ALSAchmapToAEChannelMap(map);
+    if (!candidate.ContainsChannels(info))
+      continue;
+
+    if (map->channels > bestChannels)
+    {
+      bestChannels = map->channels;
+      free(best);
+      best = CopyALSAchmap(map);
+    }
+  }
+
+  CLog::Log(LOGDEBUG, "CAESinkALSA::SelectFullLayoutChmap - chose \"{}\" for layout {}",
+            best ? ALSAchmapToString(best) : std::string("none"),
+            std::string(info));
+
+  snd_pcm_free_chmaps(supportedMaps);
+  return best;
+}
